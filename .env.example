# Copy to .env and fill in real values. Never commit .env.

# ---- LLM ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Database (M1+) ----
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis

# ---- Autopilot pipeline (M2+) ----
SERPAPI_KEY=
AUTOPILOT_CONCURRENCY=5

# ---- Reports + sessions (M3, M5) ----
REPORT_SIGNING_KEY=change-me-to-a-32-byte-random
SESSION_SIGNING_KEY=change-me-to-a-32-byte-random
REPORT_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8000

# ---- Email (M4) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=audits@aegis.local

# ---- Payments (M6, M7) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_UPI=

# ---- Admin (M4.5) ----
ADMIN_TOKEN=

# ---- Optional ----
IPAPI_TOKEN=
BYOK_VALIDATION_TTL_SECONDS=21600
# AEGIS_DISABLE_RATE_LIMIT=1   # tests only
