{
  "manifest_version": 3,
  "name": "AEGIS — AEO Auditor",
  "version": "0.1.0",
  "description": "Audit the current tab for AI search optimization (AEO). One-click score + per-check breakdown.",
  "author": "AEGIS",
  "homepage_url": "https://aegis-autopilot.com",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AEGIS — Audit this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
